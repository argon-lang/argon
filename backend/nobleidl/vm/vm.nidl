package argon.vm;

import nobleidl.core;


@esexpr:(derive-codec)
enum tube-file-entry {
    @esexpr:(inline-value)
    header {
        header: tube-header;
    },

    @esexpr:(inline-value)
    metadata {
        metadata: tube-metadata;
    },

    module-reference {
        module-id: nat;

        tube-id: nat;
        path: module-path;
    },

    @esexpr:(inline-value)
    function-definition {
        definition: function-definition;
    },

    function-reference {
        function-id: nat;
        import: import-specifier;
        signature: function-signature;
    },

    @esexpr:(inline-value)
    record-definition {
        definition: record-definition;
    },

    record-reference {
        record-id: nat;
        import: import-specifier;
        signature: function-signature;
    },

    @esexpr:(inline-value)
    enum-definition {
        definition: enum-definition;
    },

    enum-reference {
        enum-id: nat;
        import: import-specifier;
    },

    enum-variant-reference {
        variant-id: nat;

        enum-id: nat;
        name: identifier;
    },

    record-field-reference {
        record-field-id: nat;

        record-id: nat;
        name: identifier;
    },

    enum-variant-record-field-reference {
        record-field-id: nat;

        variant-id: nat;
        name: identifier;
    },

    @esexpr:(inline-value)
    trait-definition {
        definition: trait-definition;
    },

    trait-reference {
        trait-id: nat;
        import: import-specifier;
        signature: function-signature;
    },

    trait-method-reference {
        method-id: nat;
        trait-id: nat;
        name: identifier;
        erased-signature: erased-signature;
        signature: function-signature;
    },

    @esexpr:(inline-value)
    instance-definition {
        definition: instance-definition;
    },

    instance-reference {
        instance-id: nat;
        import: import-specifier;
        signature: function-signature;
    },

    instance-method-reference {
        method-id: nat;
        instance-id: nat;
        name: identifier;
        erased-signature: erased-signature;
        signature: function-signature;
    },
}


@esexpr:(derive-codec)
@esexpr:(constructor "Ar18 VMIR")
record tube-header {
    format-version-major: int;
    format-version-minor: int;
}

@esexpr:(derive-codec)
record tube-metadata {
    name: tube-name;

    @esexpr:(keyword)
    referenced-tubes: list[tube-reference];

    @esexpr:(keyword)
    @esexpr:(optional)
    platform-metadata: optional-field[esexpr];

    @esexpr:(keyword)
    modules: list[module];
}

@esexpr:(derive-codec)
record module {
    path: module-path;
}

@esexpr:(derive-codec)
record tube-reference {
    name: tube-name;

    @esexpr:(optional)
    metadata: optional-field[esexpr];
}


@esexpr:(derive-codec)
record tube-name {
    head: string;
    tail: list[string];
}

@esexpr:(derive-codec)
record module-path {
    path: list[string];
}

@esexpr:(derive-codec)
record module-name {
    tube: tube-name;
    path: module-path;
}


@esexpr:(derive-codec)
enum identifier {
    named { s: string; },
    bin-op { op: binary-operator; },
    un-op { op: unary-operator; },
    index,
    extension { inner: identifier; },
    inverse { inner: identifier; },
    update { inner: identifier; },
}

@esexpr:(derive-codec)
simple enum binary-operator {
    plus,
    minus,
    mul,
    div,
    equal,
    not-equal,
    less-than,
    less-than-eq,
    greater-than,
    greater-than-eq,
    bit-or,
    bit-xor,
    bit-and,
    shift-left,
    shift-right,
    concat,
}

@esexpr:(derive-codec)
simple enum unary-operator {
    plus,
    minus,
    bit-not,
    logical-not,
}

@esexpr:(derive-codec)
record erased-signature {
    params: list[erased-signature-type];
    result: erased-signature-type;
}

@esexpr:(derive-codec)
enum erased-signature-type {
    int,
    bool,
    string,
    never,
    array {
        element-type: erased-signature-type;
    },
    function {
        input: erased-signature-type;
        output: erased-signature-type;
    },
    record {
        record-import: import-specifier;

        @esexpr: (vararg)
        args: list[erased-signature-type];
    },
    tuple {
        @esexpr: (vararg)
        elements: list[erased-signature-type];
    },
    erased,
}

@esexpr:(derive-codec)
enum builtin-type {
    int,
    bool,
    string,
    never,
    array {
        element-type: token;
    },
    conjunction {
        lhs: token;
        rhs: token;
    },
    disjunction {
        lhs: token;
        rhs: token;
    },
}

@esexpr:(derive-codec)
enum import-specifier {
    @esexpr:(constructor "import-global")
    global {
        module-id: nat;
        name: identifier;
        sig: erased-signature;
    },

    @esexpr:(constructor "import-local")
    local {
        parent: import-specifier;
        index: nat;
    },
}


@esexpr:(derive-codec)
record function-signature {
    @esexpr:(keyword)
    token-parameters: list[signature-token-parameter];

    @esexpr:(keyword)
    parameters: list[signature-parameter];

    @esexpr:(keyword)
    return-type: token;
}

@esexpr:(derive-codec)
record signature-parameter {
    name: option[identifier];
    param-type: token;
}

@esexpr:(derive-codec)
record signature-token-parameter {
    name: option[identifier];
    kind: token;
}

@esexpr:(derive-codec)
record parameter-binding {
    name: option[identifier];
    param-type: token;
}



@esexpr:(derive-codec)
record function-definition {
    function-id: nat;
    import: import-specifier;

    @esexpr:(keyword)
    signature: function-signature;

    @esexpr:(keyword)
    @esexpr:(optional)
    implementation: optional-field[function-implementation];
}

@esexpr:(derive-codec)
enum function-implementation {
    @esexpr:(inline-value)
    vm-ir { body: function-body; },
    extern { extern: esexpr; },
}



@esexpr:(derive-codec)
record record-definition {
    record-id: nat;
    import: import-specifier;

    @esexpr:(keyword)
    signature: function-signature;

    @esexpr:(vararg)
    fields: list[record-field-definition];
}


@esexpr:(derive-codec)
record record-field-definition {
    name: identifier;
    field-type: token;

    @esexpr:(keyword)
    @esexpr:(default-value #false)
    mutable: bool;
}


@esexpr:(derive-codec)
record enum-definition {
    enum-id: nat;
    import: import-specifier;

    @esexpr:(keyword)
    signature: function-signature;

    @esexpr:(vararg)
    variants: list[enum-variant-definition];
}

@esexpr:(derive-codec)
record enum-variant-definition {
    name: identifier;

    @esexpr:(keyword)
    signature: function-signature;

    @esexpr:(vararg)
    fields: list[record-field-definition];
}

@esexpr:(derive-codec)
record trait-definition {
    trait-id: nat;
    import: import-specifier;

    @esexpr:(keyword)
    signature: function-signature;

    @esexpr:(keyword)
    vtable: vtable;

    @esexpr:(vararg)
    methods: list[method-definition];
}

@esexpr:(derive-codec)
record method-definition {
    name: identifier;
    erased-signature: erased-signature;

    @esexpr:(keyword)
    @esexpr:(default-value #false)
    abstract: bool;

    @esexpr:(keyword)
    signature: function-signature;

    @esexpr:(keyword)
    @esexpr:(optional)
    implementation: optional-field[function-implementation];
}

@esexpr:(derive-codec)
record vtable {
    @esexpr:(vararg)
    entries: list[vtable-entry];
}

@esexpr:(derive-codec)
record vtable-entry {
    slot-method-id: nat;
    slot-instance-type: token;
    target: vtable-target;
}

@esexpr:(derive-codec)
enum vtable-target {
    abstract,
    ambiguous,
    implementation {
        method-index: nat;
    },
}


@esexpr:(derive-codec)
record instance-definition {
    instance-id: nat;
    import: import-specifier;

    @esexpr:(keyword)
    signature: function-signature;

    @esexpr:(keyword)
    vtable: vtable;

    @esexpr:(vararg)
    methods: list[method-definition];
}

@esexpr:(derive-codec)
enum method-owner {
    by-trait {
        id: nat;
    },
    by-trait-object,
}

@esexpr:(derive-codec)
enum token {
    builtin {
        b: builtin-type;
    },
    function {
        input: token;
        output: token;
    },
    function-erased {
        output: token;
    },
    function-token {
        token-kind: token;
        output: token;
    },
    instance-value {
        instance-id: nat;

        @esexpr:(vararg)
        args: list[token];
    },
    record {
        record-id: nat;

        @esexpr:(vararg)
        args: list[token];
    },
    enum {
        enum-id: nat;

        @esexpr:(vararg)
        args: list[token];
    },
    parent-token-parameter {
        index: nat;
    },
    ref-cell {
        inner: token;
    },
    trait {
        trait-id: nat;

        @esexpr:(vararg)
        args: list[token];
    },
    instance-type {
        instance-id: nat;

        @esexpr:(vararg)
        args: list[token];
    },
    tuple {
        @esexpr:(vararg)
        elements: list[token];
    },
    token-parameter {
        index: nat;
    },
    type-info,
    boxed,
}

@esexpr:(derive-codec)
record function-body {
    variables: variable-declarations;
    block: block;
}

@esexpr:(derive-codec)
record variable-declarations {
    @esexpr:(vararg)
    variables: list[variable-declaration];
}

@esexpr:(derive-codec)
record variable-declaration {
    type: token;
}

@esexpr:(derive-codec)
record block {
    @esexpr:(vararg)
    instructions: list[instruction];
}

@esexpr:(derive-codec)
enum instruction {
    block {
        block-id: block-id;
        flags: block-flags;
        body: block;
    },

    block-break {
        block-id: block-id;
    },

    block-break-if {
        block-id: block-id;
        condition: register-id;
    },

    block-break-unless {
        block-id: block-id;
        condition: register-id;
    },

    block-retry {
        block-id: block-id;
    },

    box {
        dest: register-id;
        value: register-id;
    },

    builtin {
        op: builtin-op;
    },

    const-bool {
        dest: register-id;
        value: bool;
    },

    const-int {
        dest: register-id;
        value: int;
    },

    const-string {
        dest: register-id;
        value: string;
    },

    enum-variant-literal {
        dest: register-id;
        enum-type: token;
        variant-id: nat;

        @esexpr:(vararg)
        token-args: list[token];

        @esexpr:(vararg)
        args: list[register-id];

        @esexpr:(vararg)
        fields: list[record-field-literal];
    },

    finally {
        action: block;
        ensuring: block;
    },

    function-call {
        function-id: nat;
        dest: function-result;
        @esexpr:(vararg)
        token-args: list[token];
        @esexpr:(vararg)
        args: list[register-id];
    },

    function-object-call {
        dest: function-result;
        function: register-id;
        arg: register-id;
    },

    function-object-token-call {
        dest: function-result;
        function: register-id;
        arg: token;
    },

    function-object-erased-call {
        dest: function-result;
        function: register-id;
    },

    if-else {
        when-true-block-id: block-id;
        when-false-block-id: block-id;
        condition: block;
        when-true: block;
        when-false: block;
    },

    instance-method-call {
        dest: function-result;

        method-id: nat;
        instance-type: token;

        instance-object: register-id;

        @esexpr:(vararg)
        token-args: list[token];

        @esexpr:(vararg)
        args: list[register-id];
    },

    is-enum-variant-or-break {
        not-variant-block-id: block-id;
        enum-type: token;
        variant-id: nat;

        value: register-id;

        @esexpr:(vararg)
        args: list[register-id];

        @esexpr:(vararg)
        field-extractors: list[field-extractor];
    },

    load-reference {
        dest: register-id;
        ref: register-id;
    },

    load-token {
        dest: register-id;
        token: token;
    },
    
    load-instance-field {
        dest: register-id;
        instance-object: register-id;
        instance-type: token;
        parameter-index: nat;
    },

    move {
        dest: register-id;
        src: register-id;
    },

    new-instance {
        instance-id: nat;
        dest: register-id;
        @esexpr:(vararg)
        token-args: list[token];
        @esexpr:(vararg)
        args: list[register-id];
    },

    new-reference {
        dest: register-id;
        value: register-id;
    },

    partially-applied-function {
        function-id: nat;
        dest: register-id;

        @esexpr:(keyword)
        @esexpr:(default-value (list))
        token-args: list[token];

        @esexpr:(vararg)
        args: list[register-id];
    },

    partially-applied-token-function {
        function-id: nat;
        dest: register-id;

        @esexpr:(keyword)
        @esexpr:(default-value (list))
        token-args: list[token];

        @esexpr:(vararg)
        args: list[register-id];
    },

    partially-applied-function-erased {
        function-id: nat;
        dest: register-id;

        @esexpr:(keyword)
        @esexpr:(default-value (list))
        token-args: list[token];

        @esexpr:(vararg)
        args: list[register-id];
    },

    raise {
        exception: register-id;
    },

    record-field-load {
        field-id: nat;
        dest: register-id;
        record-value: register-id;
    },

    record-field-store {
        field-id: nat;
        record-value: register-id;
        field-value: register-id;
    },

    record-literal {
        dest: register-id;
        record-type: token;
        @esexpr:(vararg)
        fields: list[record-field-literal];
    },

    return {
        src: register-id;
    },

    tuple {
        dest: register-id;
        values: list[register-id];
    },

    tuple-element {
        element-index: nat;
        dest: register-id;
        src: register-id;
    },

    unbox {
        dest: register-id;
        type: token;
        value: register-id;
    },

    unreachable,

    update-reference {
        ref: register-id;
        value: register-id;
    }
}

@esexpr:(derive-codec)
record record-field-literal {
    field-id: nat;
    value: register-id;
}

@esexpr:(derive-codec)
record register-id {
    id: nat;
}

@esexpr:(derive-codec)
record block-id {
    id: nat;
}

@esexpr:(derive-codec)
flags block-flags {
    has-break = 0x01,
    has-retry = 0x02,
    is-loop = 0x04,
}


@esexpr:(derive-codec)
enum function-result {
    register { id: register-id; },
    discard,
    return-value,
}

@esexpr:(derive-codec)
enum builtin-op {
    int-negate { dest: register-id; value: register-id; },
    int-bit-not { dest: register-id; value: register-id; },
    int-add { dest: register-id; lhs: register-id; rhs: register-id; },
    int-sub { dest: register-id; lhs: register-id; rhs: register-id; },
    int-mul { dest: register-id; lhs: register-id; rhs: register-id; },
    int-bit-and { dest: register-id; lhs: register-id; rhs: register-id; },
    int-bit-or { dest: register-id; lhs: register-id; rhs: register-id; },
    int-bit-xor { dest: register-id; lhs: register-id; rhs: register-id; },
    int-bit-shift-left { dest: register-id; lhs: register-id; rhs: register-id; },
    int-bit-shift-right { dest: register-id; lhs: register-id; rhs: register-id; },
    int-eq { dest: register-id; lhs: register-id; rhs: register-id; },
    int-lt { dest: register-id; lhs: register-id; rhs: register-id; },
    int-le { dest: register-id; lhs: register-id; rhs: register-id; },
    int-gt { dest: register-id; lhs: register-id; rhs: register-id; },
    int-ge { dest: register-id; lhs: register-id; rhs: register-id; },

    string-concat {
        dest: register-id;
        @esexpr:(vararg)
        args: list[register-id];
    },
    string-eq { dest: register-id; lhs: register-id; rhs: register-id; },

    bool-not { dest: register-id; value: register-id; },
    bool-eq { dest: register-id; lhs: register-id; rhs: register-id; },

    array-create-unsafe-uninitialized {
        element-type: token;
        dest: register-id;
        length: register-id;
    },
    array-length {
        element-type: token;
        dest: register-id;
        array: register-id;
    },
    array-get {
        element-type: token;
        dest: register-id;
        array: register-id;
        index: register-id;
    },
    array-set {
        element-type: token;
        array: register-id;
        index: register-id;
        value: register-id;
    },
}

@esexpr:(derive-codec)
record field-extractor {
    r: register-id;
    field-id: nat;
}
