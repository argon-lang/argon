package argon.tube;

import nobleidl.core;


@esexpr:(derive-codec)
enum tube-file-entry {
    @esexpr:(inline-value)
    header {
        header: tube-header;
    },

    @esexpr:(inline-value)
    metadata {
        metadata: tube-metadata;
    },

    module-reference {
        module-id: nat;

        tube-id: nat;
        path: module-path;
    },

    @esexpr:(inline-value)
    function-definition {
        definition: function-definition;
    },

    function-reference {
        function-id: nat;
        import: import-specifier;
    },

    @esexpr:(inline-value)
    record-definition {
        definition: record-definition;
    },

    record-reference {
        record-id: nat;
        import: import-specifier;
    },

    @esexpr:(inline-value)
    enum-definition {
        definition: enum-definition;
    },

    enum-reference {
        enum-id: nat;
        import: import-specifier;
    },

    enum-variant-reference {
        variant-id: nat;

        enum-id: nat;
        name: identifier;
    },

    record-field-reference {
        record-field-id: nat;

        record-id: nat;
        name: identifier;
    },

    enum-variant-record-field-reference {
        record-field-id: nat;

        variant-id: nat;
        name: identifier;
    },

    @esexpr:(inline-value)
    trait-definition {
        definition: trait-definition;
    },

    trait-reference {
        trait-id: nat;
        import: import-specifier;
    },

    trait-method-reference {
        method-id: nat;
        trait-id: nat;
        name: identifier;
        signature: erased-signature;
    },

    instance-method-reference {
        method-id: nat;
        instance-id: nat;
        name: identifier;
        signature: erased-signature;
    },

    @esexpr:(inline-value)
    instance-definition {
        definition: instance-definition;
    },

    instance-reference {
        instance-id: nat;
        import: import-specifier;
    },
}


@esexpr:(derive-codec)
@esexpr:(constructor "Ar18 Tube")
record tube-header {
    format-version-major: int;
    format-version-minor: int;
}

@esexpr:(derive-codec)
record tube-metadata {
    name: tube-name;

    @esexpr:(keyword)
    platforms: list[supported-platform];

    @esexpr:(keyword)
    referenced-tubes: list[tube-name];

    @esexpr:(keyword)
    platform-metadata: dict[esexpr];

    @esexpr:(keyword)
    modules: list[module];
}

@esexpr:(derive-codec)
record supported-platform {
    id: string;
}

@esexpr:(derive-codec)
record module {
    path: module-path;

    @esexpr:(vararg)
    groups: list[export-group];
}

@esexpr:(derive-codec)
record export-group {
    name: identifier;

    @esexpr:(vararg)
    exports: list[module-export];
}


@esexpr:(derive-codec)
enum module-export {
    function {
        function-id: nat;
        access: access-modifier-global;
        signature: erased-signature;
    },

    record {
        record-id: nat;
        access: access-modifier-global;
        signature: erased-signature;
    },

    enum {
        enum-id: nat;
        access: access-modifier-global;
        signature: erased-signature;
    },

    trait {
        trait-id: nat;
        access: access-modifier-global;
        signature: erased-signature;
    },

    instance {
        instance-id: nat;
        access: access-modifier-global;
        signature: erased-signature;
    },

    exported {
        exp: module-export;
    },
}

@esexpr:(derive-codec)
enum access-modifier-global {
    public,
    internal,
    module-private,
}

@esexpr:(derive-codec)
enum access-modifier {
    public,
    private,
    protected,
    internal,
    protected-or-internal,
    protected-and-internal,
    module-private,
}



@esexpr:(derive-codec)
record tube-name {
    head: string;
    tail: list[string];
}

@esexpr:(derive-codec)
record module-path {
    path: list[string];
}

@esexpr:(derive-codec)
record module-name {
    tube: tube-name;
    path: module-path;
}

@esexpr:(derive-codec)
record file-position {
    line: nat;
    column: nat;
}

@esexpr:(derive-codec)
record location {
    file: string;
    start: file-position;
    end: file-position;
}

@esexpr:(derive-codec)
enum identifier {
    named { s: string; },
    bin-op { op: binary-operator; },
    un-op { op: unary-operator; },
    index,
    extension { inner: identifier; },
    inverse { inner: identifier; },
    update { inner: identifier; },
}

@esexpr:(derive-codec)
simple enum binary-operator {
    plus,
    minus,
    mul,
    div,
    equal,
    not-equal,
    less-than,
    less-than-eq,
    greater-than,
    greater-than-eq,
    bit-or,
    bit-xor,
    bit-and,
    shift-left,
    shift-right,
    concat,
}

@esexpr:(derive-codec)
simple enum unary-operator {
    plus,
    minus,
    bit-not,
}

@esexpr:(derive-codec)
record erased-signature {
    params: list[erased-signature-type];
    result: erased-signature-type;
}

@esexpr:(derive-codec)
enum erased-signature-type {
    int,
    i8,
    u8,
    i16,
    u16,
    i32,
    u32,
    i64,
    u64,
    bool,
    string,
    never,

    array {
        element-type: erased-signature-type;
    },
    function {
        input: erased-signature-type;
        output: erased-signature-type;
    },
    record {
        record-import: import-specifier;

        @esexpr: (vararg)
        args: list[erased-signature-type];
    },
    tuple {
        @esexpr: (vararg)
        elements: list[erased-signature-type];
    },
    erased,
}

@esexpr:(derive-codec)
enum import-specifier {
    @esexpr:(constructor "import-global")
    global {
        module-id: nat;
        name: identifier;
        sig: erased-signature;
    },

    @esexpr:(constructor "import-local")
    local {
        parent: import-specifier;
        index: nat;
    },
}


@esexpr:(derive-codec)
record instance-parameter {
    name: option[identifier];
}

@esexpr:(derive-codec)
record function-signature {
    @esexpr:(keyword)
    parameters: list[signature-parameter];

    @esexpr:(keyword)
    return-type: expr;

    @esexpr:(keyword)
    ensures-clauses: list[expr];
}

@esexpr:(derive-codec)
record signature-parameter {
    @esexpr:(keyword)
    list-type: function-parameter-list-type;

    @esexpr:(keyword)
    erasure: erasure-mode;

    @esexpr:(keyword)
    bindings: list[parameter-binding];

    name: option[identifier];
    param-type: expr;
}

@esexpr:(derive-codec)
enum function-parameter-list-type {
    normal-list,
    inferrable-list {
        level: nat;
    },
    requires-list,
}

@esexpr:(derive-codec)
record parameter-binding {
    name: option[identifier];
    param-type: expr;
}

@esexpr:(derive-codec)
enum effect-info {
    pure,
    effectful,
}

@esexpr:(derive-codec)
enum erasure-mode {
    concrete,
    erased,
    token,
}


@esexpr:(derive-codec)
record function-definition {
    function-id: nat;
    import: import-specifier;

    @esexpr:(keyword)
    @esexpr:(default-value #false)
    inline: bool;

    @esexpr:(keyword)
    erasure: erasure-mode;

    @esexpr:(keyword)
    @esexpr:(default-value #false)
    witness: bool;

    @esexpr:(keyword)
    @esexpr:(default-value (pure))
    effects: effect-info;

    @esexpr:(keyword)
    signature: function-signature;

    @esexpr:(keyword)
    @esexpr:(optional)
    implementation: optional-field[function-implementation];
}

@esexpr:(derive-codec)
enum function-implementation {
    @esexpr:(inline-value)
    expr {
        body: expr;
    },

    @esexpr:(inline-value)
    extern {
        externs: extern-map;
    },
}

@esexpr:(derive-codec)
@esexpr:(constructor "externs")
record extern-map {
    @esexpr:(dict)
    externs: dict[esexpr];
}


@esexpr:(derive-codec)
record record-definition {
    record-id: nat;
    import: import-specifier;

    @esexpr:(keyword)
    signature: function-signature;

    @esexpr:(vararg)
    fields: list[record-field-definition];
}


@esexpr:(derive-codec)
record record-field-definition {
    field-id: nat;
    name: identifier;
    field-type: expr;

    @esexpr:(keyword)
    @esexpr:(default-value #false)
    mutable: bool;
}

@esexpr:(derive-codec)
record enum-definition {
    enum-id: nat;
    import: import-specifier;

    @esexpr:(keyword)
    signature: function-signature;

    @esexpr:(vararg)
    variants: list[enum-variant-definition];
}

@esexpr:(derive-codec)
record enum-variant-definition {
    variant-id: nat;
    name: identifier;

    @esexpr:(keyword)
    signature: function-signature;

    @esexpr:(vararg)
    fields: list[record-field-definition];
}

@esexpr:(derive-codec)
record trait-definition {
    trait-id: nat;
    import: import-specifier;
    location: location;

    @esexpr:(keyword)
    signature: function-signature;

    @esexpr:(vararg)
    methods: list[method-entry];
}

@esexpr:(derive-codec)
record method-entry {
    access: access-modifier;
    method: method-definition;
}

@esexpr:(derive-codec)
record method-definition {
    method-id: nat;
    name: identifier;
    erased-signature: erased-signature;

    @esexpr:(keyword)
    @esexpr:(default-value #false)
    inline: bool;

    @esexpr:(keyword)
    @esexpr:(default-value #false)
    erased: bool;

    @esexpr:(keyword)
    @esexpr:(default-value #false)
    witness: bool;

    @esexpr:(keyword)
    slot: method-slot;

    @esexpr:(keyword)
    @esexpr:(default-value (pure))
    effects: effect-info;

    @esexpr:(keyword)
    instance-parameter: instance-parameter;

    @esexpr:(keyword)
    signature: function-signature;

    @esexpr:(keyword)
    @esexpr:(optional)
    implementation: optional-field[method-implementation];
}

@esexpr:(derive-codec)
record instance-definition {
    instance-id: nat;
    import: import-specifier;
    location: location;

    @esexpr:(keyword)
    erasure: erasure-mode;

    @esexpr:(keyword)
    signature: function-signature;

    @esexpr:(vararg)
    methods: list[method-entry];
}

@esexpr:(derive-codec)
enum method-slot {
    abstract,
    abstract-override,
    virtual,
    override,
    final,
    final-override,
}

@esexpr:(derive-codec)
enum method-implementation {
    abstract,

    @esexpr:(inline-value)
    expr {
        body: expr;
    },

    @esexpr:(inline-value)
    extern {
        externs: extern-map;
    },
}

@esexpr:(derive-codec)
record located-expr {
    location: location;
    value: expr;
}

@esexpr:(derive-codec)
enum expr {
    error,
    erased-value {
        type: located-expr;
    },
    and {
        a: located-expr;
        b: located-expr;
    },
    bind-variable {
        v: local-var;
        value: located-expr;
    },
    bind-erased-alias {
        v: local-var;

        @esexpr:(keyword)
        @esexpr:(optional)
        equality-witness: optional-field[local-var];

        value: located-expr;
    },
    bind-ensures {
        value: located-expr;

        @esexpr:(vararg)
        variables: list[local-var];
    },
    bool-literal {
        value: bool;
    },
    box {
        t: located-expr;
        value: located-expr;
    },
    builtin {
        builtin: builtin;
    },
    boxed {
        t: located-expr;
    },
    block {
        label: block-label;
        body: located-expr;
    },
    break {
        block-id: block-id;
        value: located-expr;
    },
    conjunction-type {
        lhs: located-expr;
        rhs: located-expr;
    },
    closure {
        v: closure-parameter-var;
        return-type: located-expr;
        body: located-expr;
    },
    disjunction-type {
        lhs: located-expr;
        rhs: located-expr;
    },
    equal-to-type {
        type: located-expr;
        lhs: located-expr;
        rhs: located-expr;
    },
    condition {
        value: located-expr;

        @esexpr:(keyword)
        @esexpr:(optional)
        when-true-witness: optional-field[local-var];

        @esexpr:(keyword)
        @esexpr:(optional)
        when-false-witness: optional-field[local-var];
    },
    @esexpr:(inline-value)
    enum-type {
        enum-type: enum-type;
    },
    enum-variant-literal {
        enum-type: enum-type;
        variant-id: nat;

        @esexpr:(vararg)
        args: list[located-expr];

        @esexpr:(vararg)
        fields: list[record-field-literal];
    },
    finally {
        action: located-expr;
        ensuring: located-expr;
    },
    function-call {
        id: nat;

        @esexpr:(vararg)
        args: list[located-expr];
    },
    function-object-call {
        f: located-expr;
        a: located-expr;
    },
    function-type {
        a: closure-parameter-var;
        r: located-expr;
    },
    if-else {
        condition: located-expr;
        true-body: located-expr;
        false-body: located-expr;
    },
    use {
        is-mutable: bool;
        inner: located-expr;
    },
    shared {
        inner: located-expr;
    },
    share {
        value: located-expr;
    },
    borrow {
        value: located-expr;
    },
    borrow-mut {
        value: located-expr;
    },
    instance-method-call {
        method-id: nat;
        instance-type: method-instance-type;
        instance: located-expr;

        @esexpr:(vararg)
        args: list[located-expr];
    },
    @esexpr:(inline-value)
    instance-singleton-type {
        instance-singleton-type: instance-singleton-type;
    },
    int-literal {
        i: int;
    },
    i8-literal {
        value: i8;
    },
    u8-literal {
        value: u8;
    },
    i16-literal {
        value: i16;
    },
    u16-literal {
        value: u16;
    },
    i32-literal {
        value: i32;
    },
    u32-literal {
        value: u32;
    },
    i64-literal {
        value: i64;
    },
    u64-literal {
        value: u64;
    },
    is {
        value: located-expr;
        pattern: pattern;
    },
    match {
        value: located-expr;
        cases: list[match-case];
    },
    new-instance {
        instance-id: nat;
        args: list[located-expr];
    },
    not {
        a: located-expr;
    },
    or {
        a: located-expr;
        b: located-expr;
    },
    raise {
        ex: located-expr;
    },
    @esexpr:(inline-value)
    record-type {
        record-type: record-type;
    },
    record-field-load {
        record: record-type;
        field-id: nat;
        record-value: located-expr;
    },
    record-field-store {
        record: record-type;
        field-id: nat;
        record-value: located-expr;
        field-value: located-expr;
    },
    record-literal {
        record: record-type;

        @esexpr:(vararg)
        fields: list[record-field-literal];
    },
    retry {
        block-id: block-id;
    },
    ref-cell-type {
        element-type: located-expr;
    },
    ref-cell-create {
        element-type: located-expr;
        value: located-expr;
    },
    ref-cell-load {
        cell: located-expr;
    },
    ref-cell-store {
        cell: located-expr;
        value: located-expr;
    },
    sequence {
        head: located-expr;

        @esexpr:(vararg)
        tail: list[located-expr];
    },
    string-literal {
        s: string;
    },
    @esexpr:(inline-value)
    trait-type {
        trait-type: trait-type;
    },
    tuple {
        items: list[located-expr];
    },
    tuple-element {
        index: nat;
        tuple: located-expr;
    },
    type-n {
        n: located-expr;
    },
    type-big-n {
        n: nat;
    },
    unbox {
        t: located-expr;
        value: located-expr;
    },
    variable {
        v: var;
    },
    variable-store {
        v: var;
        value: located-expr;
    },
}

@esexpr:(derive-codec)
enum pattern {
    error,
    discard {
        t: expr;
    },
    tuple {
        @esexpr:(vararg)
        items: list[pattern];
    },
    binding {
        v: local-var;
        pattern: pattern;
    },
    enum-variant {
        enum-type: enum-type;
        variant-id: nat;

        @esexpr:(vararg)
        args: list[pattern];

        @esexpr:(vararg)
        fields: list[record-field-pattern];
    },
    string {
        s: string;
    },
    int {
        i: int;
    },
    bool {
        b: bool;
    },
}

@esexpr:(derive-codec)
record match-case {
    pattern: pattern;
    body: located-expr;
}

@esexpr:(derive-codec)
record record-field-pattern {
    field-id: nat;
    pattern: pattern;
}


@esexpr:(derive-codec)
enum builtin {
    int-type {
        integer-type: integer-type;
    },
    bool-type,
    string-type,
    never-type,
    array-type {
        element-type: located-expr;
    },

    int-negate { integer-type: integer-type; value: located-expr; },
    int-bit-not { integer-type: integer-type; value: located-expr; },
    int-convert { source-type: integer-type; dest-type: integer-type; value: located-expr; },
    int-add { integer-type: integer-type; lhs: located-expr; rhs: located-expr; },
    int-sub { integer-type: integer-type; lhs: located-expr; rhs: located-expr; },
    int-mul { integer-type: integer-type; lhs: located-expr; rhs: located-expr; },
    int-bit-and { integer-type: integer-type; lhs: located-expr; rhs: located-expr; },
    int-bit-or { integer-type: integer-type; lhs: located-expr; rhs: located-expr; },
    int-bit-xor { integer-type: integer-type; lhs: located-expr; rhs: located-expr; },
    int-bit-shift-left { integer-type: integer-type; lhs: located-expr; rhs: located-expr; },
    int-bit-shift-right { integer-type: integer-type; lhs: located-expr; rhs: located-expr; },
    int-eq { integer-type: integer-type; lhs: located-expr; rhs: located-expr; },
    int-lt { integer-type: integer-type; lhs: located-expr; rhs: located-expr; },
    int-le { integer-type: integer-type; lhs: located-expr; rhs: located-expr; },
    int-gt { integer-type: integer-type; lhs: located-expr; rhs: located-expr; },
    int-ge { integer-type: integer-type; lhs: located-expr; rhs: located-expr; },
    
    string-concat {
        @esexpr:(vararg)
        values: list[located-expr];
    },
    string-eq { lhs: located-expr; rhs: located-expr; },

    bool-eq { lhs: located-expr; rhs: located-expr; },
    
    array-create-unsafe-uninitialized {
        element-type: located-expr;
        length: located-expr;
    },
    array-length {
        element-type: located-expr;
        array: located-expr;
    },
    array-get {
        element-type: located-expr;
        array: located-expr;
        index: located-expr;
    },
    array-set {
        element-type: located-expr;
        array: located-expr;
        index: located-expr;
        value: located-expr;
    },
    equal-to-refl {
        type: located-expr;
        value: located-expr;
    },
    unsafe-assume-erased {
        type: located-expr;
    },
}

@esexpr:(derive-codec)
simple enum integer-type {
    int,
    i8,
    u8,
    i16,
    u16,
    i32,
    u32,
    i64,
    u64,
}

@esexpr:(derive-codec)
record local-var {
    id: nat;
    var-type: expr;
    name: option[identifier];

    @esexpr:(keyword)
    @esexpr:(default-value #false)
    mutable: bool;

    @esexpr:(keyword)
    @esexpr:(default-value #false)
    erased: bool;

    @esexpr:(keyword)
    @esexpr:(default-value #false)
    witness: bool;
}

@esexpr:(derive-codec)
record closure-parameter-var {
    id: nat;
    var-type: expr;
    name: option[identifier];

    @esexpr:(keyword)
    @esexpr:(default-value #false)
    mutable: bool;

    @esexpr:(keyword)
    erasure: erasure-mode;

    @esexpr:(keyword)
    @esexpr:(default-value #false)
    witness: bool;
}

@esexpr:(derive-codec)
record record-type {
    id: nat;

    @esexpr:(vararg)
    args: list[located-expr];
}

@esexpr:(derive-codec)
record trait-type {
    id: nat;

    @esexpr:(vararg)
    args: list[located-expr];
}

@esexpr:(derive-codec)
record instance-singleton-type {
    id: nat;

    @esexpr:(vararg)
    args: list[located-expr];
}

@esexpr:(derive-codec)
enum method-instance-type {
    @esexpr:(inline-value)
    trait-type {
        trait-type: trait-type;
    },

    instance-singleton-type {
        instance-singleton-type: instance-singleton-type;
    },
}


@esexpr:(derive-codec)
record record-field-literal {
    field-id: nat;
    value: located-expr;
}

@esexpr:(derive-codec)
record enum-type {
    id: nat;

    @esexpr:(vararg)
    args: list[located-expr];
}

@esexpr:(derive-codec)
enum var {
    local-var {
        id: nat;
    },
    instance-parameter-var {
        owner: expression-owner;
        name: option[identifier];
        var-type: expr;
    },
    parameter-var {
        owner: expression-owner;
        parameter-index: int;
        name: option[identifier];
        var-type: expr;

        @esexpr:(keyword)
        erasure: erasure-mode;

        @esexpr:(keyword)
        @esexpr:(default-value #false)
        witness: bool;
    },
    closure-parameter-var {
        id: nat;
    },
}

@esexpr:(derive-codec)
enum expression-owner {
    func {
        index: nat;
    },
    rec {
        index: nat;
    },
    enum {
        index: nat;
    },
    trait {
        index: nat;
    },
    instance {
        index: nat;
    },
    enum-variant {
        index: nat;
    },
    method {
        index: nat;
    },
    field {
        index: nat;
    },
}

@esexpr:(derive-codec)
record block-label {
    id: nat;
    @esexpr:(optional)
    name: optional-field[identifier];
    kind: block-label-kind;
    block-result-type: expr;
}

@esexpr:(derive-codec)
simple enum block-label-kind {
    block,
    loop,
    while-outer,
    while-inner,
}


@esexpr:(derive-codec)
record block-id {
    id: nat;
}
