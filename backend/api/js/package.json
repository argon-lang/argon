{
  "name": "@argon-lang/js-backend-api",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "author": "",
  "main": "./lib/index.js",
  "type": "module",
  "scripts": {
    "codegen": "cpy --flat ../../vm/vm.nidl src/ && cpy --flat ../nobleidl/metadata.nidl src/ && noble-idl-compiler-js --output-dir src-gen",
    "build": "npm run codegen && tsc --project . && cd out/src-gen && cpy . ../../lib/ && cd ../src && cpy . ../../lib/"
  },
  "exports": {
    ".": "./lib/index.js",
    "./metadata.js": "./lib/metadata.js",
    "./js-platform-metadata.js": "./lib/js-platform-metadata.js",
    "./vm.js": "./lib/vm.js"
  },
  "devDependencies": {
    "@argon-lang/noble-idl-compiler-js": "file:../../../../noble-idl/langs/js/backend",
    "@types/estree": "^1.0.8",
    "@types/node": "^25.9.1",
    "cpy-cli": "^7.0.0",
    "make-dir-cli": "^4.0.0",
    "rimraf": "^6.0.1",
    "type-fest": "^5.6.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@argon-lang/esexpr": "^0.3.0",
    "@argon-lang/noble-idl-core": "file:../../../../noble-idl/langs/js/runtime"
  },
  "NobleIDL": {
    "inputFiles": [
      "src/metadata.nidl",
      "src/js-platform-metadata.nidl",
      "src/vm.nidl"
    ],
    "packageMapping": {
      "argon.backend.metadata": "metadata",
      "argon.jsbackendmetadata": "js-platform-metadata",
      "argon.vm": "vm"
    }
  }
}
