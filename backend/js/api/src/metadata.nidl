package argon.backend.metadata;

import nobleidl.core;


@esexpr:(derive-codec)
record platform-metadata-result {
    platform: string;

    @esexpr:(keyword)
    tube-metadata: esexpr;

    @esexpr:(keyword)
    externs: dict[extern];
}

@esexpr:(derive-codec)
enum extern {
    extern-function {
        name: string;
        implementation: esexpr;
    },
    extern-method {
        name: string;
        implementation: esexpr;
    },
    extern-static-method {
        name: string;
        implementation: esexpr;
    },
}
