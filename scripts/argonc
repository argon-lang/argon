#!/bin/sh

set -eu

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
dist_dir="$(CDPATH= cd -- "$script_dir/.." && pwd)"
wasm_argonc="$dist_dir/arch/wasm32-unknown-emscripten/argonc.js"

run_wasm() {
    if ! command -v node >/dev/null 2>&1; then
        printf 'argonc: Node.js is required to run the WebAssembly executable\n' >&2
        exit 1
    fi
    exec node "$wasm_argonc" "$@"
}

if [ -n "${ARGONC_FORCE_WASM:-}" ]; then
    run_wasm "$@"
fi


os="$(uname -s)"
arch="$(uname -m)"

case "$os:$arch" in
    Linux:x86_64)
        arch_dir=x86_64-unknown-linux-gnu
        ;;
    Linux:i386|Linux:i486|Linux:i586|Linux:i686)
        arch_dir=i686-unknown-linux-gnu
        ;;
    Linux:aarch64|Linux:arm64)
        arch_dir=aarch64-unknown-linux-gnu
        ;;
    *)
        arch_dir=
        ;;
esac

if [ -n "$arch_dir" ] && [ -x "$dist_dir/arch/$arch_dir/argonc" ]; then
    exec "$dist_dir/arch/$arch_dir/argonc" "$@"
fi

run_wasm "$@"
