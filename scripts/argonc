#!/bin/sh

set -eu

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
dist_dir="$(CDPATH= cd -- "$script_dir/.." && pwd)"


bold=
underline=
red=
reset=

if [ "${CLICOLOR_FORCE:-0}" = 1 ] || { [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${CLICOLOR:-1}" != 0 ]; }; then
    bold="$(printf '\033[1m')"
    underline="$(printf '\033[4m')"
    red="$(printf '\033[31m')"
    reset="$(printf '\033[0m')"
fi

print_help() {
    printf '%s%sUsage: %s%s <command>\n' "$bold" "$underline" "$(basename "$0")" "$reset"
    printf '\n'
    printf '%s%sCommands:%s\n' "$bold" "$underline" "$reset"
    printf '  %scompile%s             %s\n' "$bold" "$reset" "$(describe_command 'Compile Argon source code to a tube (.artube)' compile)"
    printf '  %sgenir%s               %s\n' "$bold" "$reset" "$(describe_command 'Generate Argon VM IR from a tube' genir)"
    printf '  %scodegen%s             %s\n' "$bold" "$reset" "$(describe_command 'Generate code from Argon VM IR' codegen)"
    printf '  %splatform-metadata%s   %s\n' "$bold" "$reset" "$(describe_platform_metadata)"
    printf '  %shelp%s                Print this message or the help of the given subcommand(s)\n' "$bold" "$reset"
    printf '\n'
    printf '%s%sOptions:%s\n' "$bold" "$underline" "$reset"
    printf ' %s-h%s, %s--help%s\n' "$bold" "$reset" "$bold" "$reset"
}

print_platform_metadata_help() {
    printf '%s%sUsage: %s%s platform-metadata <command>\n' "$bold" "$underline" "$(basename "$0")" "$reset"
    printf '\n'
    printf '%s\n' "$(describe_platform_metadata)"
    printf '\n'
    printf '%s%sCommands:%s\n' "$bold" "$underline" "$reset"

    for backend in $(all_backends); do
        printf '  %s%s%s%s%s\n' "$bold" "$backend" "$reset" "$(platform_metadata_padding "$backend")" "$(describe_platform_metadata_backend "$backend")"
    done

    printf '  %shelp%s%sPrint this message or the help of the given subcommand(s)\n' "$bold" "$reset" "$(platform_metadata_padding help)"
    printf '\n'
    printf '%s%sOptions:%s\n' "$bold" "$underline" "$reset"
    printf ' %s-h%s, %s--help%s\n' "$bold" "$reset" "$bold" "$reset"
}

unknown_command() {
    value="$1"
    help_printer="$2"

    printf '%serror:%s unknown command: '\''%s'\''\n\n' "$red" "$reset" "$value" >&2
    "$help_printer" >&2
    exit 1
}

platform_target() {
    os="$(uname -s)"
    arch="$(uname -m)"

    case "$os:$arch" in
        Linux:x86_64)
            printf '%s\n' x86_64-unknown-linux-gnu
            ;;
        Linux:i386|Linux:i486|Linux:i586|Linux:i686)
            printf '%s\n' i686-unknown-linux-gnu
            ;;
        Linux:aarch64|Linux:arm64)
            printf '%s\n' aarch64-unknown-linux-gnu
            ;;
        MINGW*:x86_64|MSYS*:x86_64|CYGWIN*:x86_64)
            printf '%s\n' x86_64-pc-windows-gnu
            ;;
        MINGW*:i386|MINGW*:i486|MINGW*:i586|MINGW*:i686|MSYS*:i386|MSYS*:i486|MSYS*:i586|MSYS*:i686|CYGWIN*:i386|CYGWIN*:i486|CYGWIN*:i586|CYGWIN*:i686)
            printf '%s\n' i686-pc-windows-gnu
            ;;
        *)
            printf 'argonc: unsupported platform: %s %s\n\n' "$os" "$arch" >&2
            print_help >&2
            exit 1
            ;;
    esac
}

binary_path() {
    target="$(platform_target)"
    printf '%s\n' "$dist_dir/arch/$target/argonc"
}

run_binary() {
    binary="$(binary_path)"

    if [ ! -x "$binary" ]; then
        printf 'argonc: compiler binary not found or not executable: %s\n\n' "$binary" >&2
        print_help >&2
        exit 1
    fi

    exec "$binary" "$@"
}

run_backend() {
    backend="$1"
    subcommand="$2"
    shift
    shift

    case "$backend" in
        js)
            cli="$dist_dir/backend/js/lib/main.js"

            if [ ! -f "$cli" ]; then
                printf 'argonc: JavaScript backend CLI not found: %s\n\n' "$cli" >&2
                print_help >&2
                exit 1
            fi

            exec node "$cli" "$@"
            ;;
        *)
            unknown_command "$subcommand" print_help
            ;;
    esac
}

describe_command() {
    printf '%s\n' "$("$binary" help-description "$@" 2>/dev/null)"
}

describe_platform_metadata() {
    cli="$dist_dir/backend/js/lib/main.js"
    printf '%s\n' "$(node "$cli" help-description platform-metadata 2>/dev/null)"
}

describe_platform_metadata_backend() {
    backend="$1"
    dispatch_platform_metadata "$backend" help-description platform-metadata "$backend"
}

all_backends() {
    printf '%s\n' js
}

platform_metadata_padding() {
    case "$1" in
        ?)
            printf '       '
            ;;
        ??)
            printf '      '
            ;;
        ???)
            printf '     '
            ;;
        ????)
            printf '    '
            ;;
        ?????)
            printf '   '
            ;;
        ??????)
            printf '  '
            ;;
        ???*)
            printf '  '
            ;;
    esac
}

handle_help_command() {
    help_printer="$1"
    dispatcher="$2"
    shift 2

    if [ "$#" -eq 0 ] || [ "$1" != help ]; then
        return 0
    fi

    shift
    if [ "$#" -eq 0 ]; then
        "$help_printer"
        exit 0
    fi

    subcommand="$1"
    shift
    "$dispatcher" "$subcommand" help "$@"
    exit $?
}

dispatch_platform_metadata() {
    case "$1" in
        -h|--help)
            print_platform_metadata_help
            exit 0
            ;;
        *)
            backend="$1"
            shift

            run_backend "$backend" "platform-metadata $backend" platform-metadata "$backend" "$@"
            ;;
    esac
}

dispatch_argonc() {
    case "$1" in
    -h|--help)
        print_help
        exit 0
        ;;
    compile|genir)
        subcommand="$1"
        shift
        if [ "$#" -gt 0 ] && [ "$1" = help ]; then
            shift
            run_binary "$subcommand" help "$@"
        fi
        run_binary "$subcommand" "$@"
        ;;
    codegen)
        shift
        if [ "$#" -eq 0 ]; then
            printf 'argonc: missing codegen backend\n\n' >&2
            print_help >&2
            exit 1
        fi

        case "$1" in
            js)
                shift
                if [ "$#" -gt 0 ] && [ "$1" = help ]; then
                    shift
                    run_binary codegen js help "$@"
                fi
                run_binary codegen js "$@"
                ;;
            -h|--help)
                run_binary codegen --help
                ;;
            help)
                shift
                run_binary codegen help "$@"
                ;;
            *)
                unknown_command "codegen $1" print_help
                ;;
        esac
        ;;
    platform-metadata)
        shift
        if [ "$#" -eq 0 ]; then
            printf 'argonc: missing platform-metadata backend\n\n' >&2
            print_platform_metadata_help >&2
            exit 1
        fi

        handle_help_command print_platform_metadata_help dispatch_platform_metadata "$@"
        dispatch_platform_metadata "$@"
        ;;
        *)
            unknown_command "$1" print_help
            ;;
    esac
}

if [ "$#" -eq 0 ]; then
    print_help >&2
    exit 1
fi

handle_help_command print_help dispatch_argonc "$@"
dispatch_argonc "$@"
