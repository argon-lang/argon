module _

import Argon.Core::Array
import Argon.Core::U8

public trait Resource (token T: type)
    public def _.resource: T = abstract
    public proc _.close(): () = abstract
end

public trait InputStream
    public proc _.read(array: Array U8, offset: Int, count: Int)(requires erased ev: (offset >= 0 && count >= 0 && offset + count <= array.length) == true): Int = abstract
end

public trait OutputStream
    public proc _.write(array: Array U8, offset: Int, count: Int)(requires erased ev: (offset >= 0 && count >= 0 && offset + count <= array.length) == true): () ensures ((result >= 0 && result <= count) == true) = abstract
end

