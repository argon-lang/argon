public inline def operator >= (a: I32) (b: I32): Bool = __argon_builtin i32_ge a b

public def extension to_s (n: I32)(): String = extern i32_to_s
public inline def extension to_i (n: I32): Int = __argon_builtin i32_to_int n

public inline def extension to_i8 (n: I32) (requires erased ev: ((n.to_i >= (-128) && n.to_i <= 127) == true)): __argon_builtin i8_type = __argon_builtin i32_to_i8 n
