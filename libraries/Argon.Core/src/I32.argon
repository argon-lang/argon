public inline def operator >>> (a: I32) (b: I32) (requires erased ev: ((b >= 0i32 && b < 32i32) == true)): I32 = __argon_builtin i32_bitshiftright a b

public inline def operator = (a: I32) (b: I32): Bool = __argon_builtin i32_eq a b
public inline def operator != (a: I32) (b: I32): Bool = !(__argon_builtin i32_eq a b)
public inline def operator < (a: I32) (b: I32): Bool = __argon_builtin i32_lt a b
public inline def operator <= (a: I32) (b: I32): Bool = __argon_builtin i32_le a b
