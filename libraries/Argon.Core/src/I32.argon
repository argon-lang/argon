public inline def unary operator ~~~ (a: I32): I32 = __argon_builtin i32_bitnot a

public inline def operator + (a: I32) (b: I32) (requires erased ev: (((__argon_builtin int_add a.to_i b.to_i) >= (-2147483648) && (__argon_builtin int_add a.to_i b.to_i) <= 2147483647) == true)): I32 = __argon_builtin i32_add a b
public inline def operator - (a: I32) (b: I32) (requires erased ev: (((__argon_builtin int_sub a.to_i b.to_i) >= (-2147483648) && (__argon_builtin int_sub a.to_i b.to_i) <= 2147483647) == true)): I32 = __argon_builtin i32_sub a b
