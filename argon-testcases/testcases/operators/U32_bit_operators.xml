<ArgonTest>

    <Name>U32 bit operators</Name>

    <InputSource name="index.argon"><![CDATA[

        module _

        import Argon.Core::*

        proc main(): () do
            puts ((0b1000u32 ||| 0b1u32).to_s())
            puts ((0b1000u32 ||| 0b1000u32).to_s())
            puts ((0b1000u32 &&& 0b1u32).to_s())
            puts ((0b1000u32 &&& 0b1000u32).to_s())
            puts ((0b1000u32 ^^^ 0b1u32).to_s())
            puts ((0b1000u32 ^^^ 0b1000u32).to_s())
            puts ((0b1000u32 <<< 0b11u32).to_s())
            puts ((0b1000u32 >>> 0b11u32).to_s())
            puts ((~~~0b1000u32).to_s())
            puts ((~~~0b1u32).to_s())
        end

    ]]></InputSource>

    <ExpectedOutput>
        9
        8
        0
        8
        9
        0
        64
        1
        4294967287
        4294967294
    </ExpectedOutput>

</ArgonTest>
