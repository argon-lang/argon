<ArgonTest>

    <Name>U16 comparison operators</Name>

    <InputSource name="index.argon"><![CDATA[

        module _

        import Argon.Core::*

        proc main(): () do
            puts ((999u16 = 2u16).to_s())
            puts ((999u16 = 999u16).to_s())
            puts ((999u16 != 2u16).to_s())
            puts ((999u16 != 999u16).to_s())
            puts ((999u16 < 2u16).to_s())
            puts ((999u16 < 999u16).to_s())
            puts ((999u16 <= 2u16).to_s())
            puts ((999u16 <= 999u16).to_s())
            puts ((999u16 > 2u16).to_s())
            puts ((999u16 > 999u16).to_s())
            puts ((999u16 >= 2u16).to_s())
            puts ((999u16 >= 999u16).to_s())
        end

    ]]></InputSource>

    <ExpectedOutput>
        false
        true
        true
        false
        false
        false
        false
        true
        true
        false
        true
        true
    </ExpectedOutput>

</ArgonTest>
