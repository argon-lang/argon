<ArgonTest>

    <Name>U8 bit operators</Name>


    <InputSource name="index.argon"><![CDATA[

        module _

        import Argon.Core::*

        proc main(): () do
            puts ((0b1000u8 ||| 0b1u8).to_s())
            puts ((0b1000u8 ||| 0b1000u8).to_s())
            puts ((0b1000u8 &&& 0b1u8).to_s())
            puts ((0b1000u8 &&& 0b1000u8).to_s())
            puts ((0b1000u8 ^^^ 0b1u8).to_s())
            puts ((0b1000u8 ^^^ 0b1000u8).to_s())
            puts ((0b1000u8 <<< 0b11u8).to_s())
            puts ((0b1000u8 >>> 0b11u8).to_s())
            puts ((~~~0b1000u8).to_s())
            puts ((~~~0b1u8).to_s())
        end


    ]]></InputSource>

    <ExpectedOutput>
        9
        8
        0
        8
        9
        0
        64
        1
        247
        254
    </ExpectedOutput>

</ArgonTest>
