<ArgonTest>

    <Name>I32 bit operators</Name>

    <InputSource name="index.argon"><![CDATA[

        module _

        import Argon.Core::*

        proc main(): () do
            puts ((0b1000i32 ||| 0b1i32).to_s())
            puts ((0b1000i32 ||| 0b1000i32).to_s())
            puts ((0b1000i32 &&& 0b1i32).to_s())
            puts ((0b1000i32 &&& 0b1000i32).to_s())
            puts ((0b1000i32 ^^^ 0b1i32).to_s())
            puts ((0b1000i32 ^^^ 0b1000i32).to_s())
            puts ((0b1000i32 <<< 0b11i32).to_s())
            puts (((-0b1000i32) >>> 0b1i32).to_s())
            puts ((~~~0b1000i32).to_s())
            puts ((~~~(-0b1i32)).to_s())
        end

    ]]></InputSource>

    <ExpectedOutput>
        9
        8
        0
        8
        9
        0
        64
        -4
        -9
        0
    </ExpectedOutput>

</ArgonTest>
