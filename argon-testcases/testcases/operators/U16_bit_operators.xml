<ArgonTest>

    <Name>U16 bit operators</Name>

    <InputSource name="index.argon"><![CDATA[

        module _

        import Argon.Core::*

        proc main(): () do
            puts ((0b1000u16 ||| 0b1u16).to_s())
            puts ((0b1000u16 ||| 0b1000u16).to_s())
            puts ((0b1000u16 &&& 0b1u16).to_s())
            puts ((0b1000u16 &&& 0b1000u16).to_s())
            puts ((0b1000u16 ^^^ 0b1u16).to_s())
            puts ((0b1000u16 ^^^ 0b1000u16).to_s())
            puts ((0b1000u16 <<< 0b11u16).to_s())
            puts ((0b1000u16 >>> 0b11u16).to_s())
            puts ((~~~0b1000u16).to_s())
            puts ((~~~0b1u16).to_s())
        end

    ]]></InputSource>

    <ExpectedOutput>
        9
        8
        0
        8
        9
        0
        64
        1
        65527
        65534
    </ExpectedOutput>

</ArgonTest>
